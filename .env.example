# ─────────────────────────── Application ───────────────────────────
APP_NAME="inner-rag Knowledge Base"
APP_VERSION="0.3.0"
# Written to every log line and every span; used to compare metrics
# by environment and by version.
APP_ENV=dev
DEBUG=true
# /docs, /redoc and /openapi.json are served only while this is true; turn it off in
# production so the full API surface is not published.
ENABLE_DOCS=true

# ─────────────────────────── Auth ──────────────────────────────────
# Local accounts + JWT (HS256). Accounts are provisioned by ops — there is NO
# self-service signup, and there is no logout endpoint (stateless JWT; the client
# just drops the token):
#   uv run scripts/create_user.py <username>
#   uv run scripts/create_user.py --list | --reset-password | --disable | --enable
# Signing key. With DEBUG=false the server refuses to start on the default value or
# on anything shorter than 32 bytes (short keys are brute-forceable offline):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY="dev-only-insecure-secret-change-me-in-production"
# Access token TTL (minutes). A stateless token cannot be revoked individually, so a
# short TTL is the only bound on a leaked token; disabling the account takes effect
# immediately (the user row is re-read on every request).
AUTH_TOKEN_TTL_MINUTES=720

# ─────────────────────────── Server ────────────────────────────────
HOST=0.0.0.0
# NOTE: 8000 is frequently taken on shared machines; keep this in sync with
# frontend/vite.config.js (proxy target) and frontend/src/api/index.js.
PORT=8010

# ─────────────────────────── Database ──────────────────────────────
# Dev default: SQLite, zero setup, single file under data/ (gitignored).
DATABASE_URL=sqlite:///./data/inner_rag.db
# Deployment option: PostgreSQL 16 — same schema, just switch the DSN and re-run
# `uv run alembic upgrade head`:
#   docker compose up -d postgres
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# SQLite lock wait timeout (seconds); background parsing and requests may write concurrently.
SQLITE_TIMEOUT=30
# Schema is owned by Alembic: run `uv run alembic upgrade head` before first start.
# Set to true only for throwaway dev databases / tests (uses create_all).
AUTO_CREATE_TABLES=false
SQL_ECHO=false

# ─────────────────────────── Secrets ──────────────────────────────
# This file is a template. Real values live in `.env` (gitignored):
#   cp .env.example .env
# Never hardcode keys in source and never commit `.env`.
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ─────────────────────────── Model providers ───────────────────────
# Switch backends by editing ONLY these two variables; nothing else in the codebase is
# provider specific.
#
#   LLM_PROVIDER       = ollama | openrouter | deepseek | openai | mock
#   EMBEDDING_PROVIDER = sentence_transformers | ollama | openrouter | openai | mock
#                        (DeepSeek ships no embeddings API, so it is chat-only)
#
# * sentence_transformers: open-source weights running IN THIS PROCESS (default). No quota,
#   no fee, no network. Needs the optional extra: `uv sync --extra local-embed`.
#   Recommended precisely because cloud gateways rate-limit by *request count* (some free
#   tiers allow only 1000 requests/day) — one full-corpus rebuild eats hundreds of them.
# * mock    : fully offline, deterministic, no key. For demos / CI / degraded acceptance.
# * ollama  : local, no key, needs `ollama serve` (an extra service to run).
# * openrouter/openai: OpenAI-compatible HTTP APIs.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=sentence_transformers

# Local embedding weights (sentence-transformers). Any Hugging Face repo id works.
# Qwen3-Embedding-0.6B: 1024 dims, multilingual, fast enough even on CPU. Step up to
# Qwen/Qwen3-Embedding-4B or -8B for higher retrieval quality — the vector dimension
# changes with the model, so you MUST rebuild the index (the vector space is not compatible).
# Behind the GFW set HF_ENDPOINT=https://hf-mirror.com so the download does not stall.
SENTENCE_TRANSFORMERS_MODEL=Qwen/Qwen3-Embedding-0.6B
# auto = use CUDA when available; also accepts cpu / cuda / cuda:0 / cuda:1
SENTENCE_TRANSFORMERS_DEVICE=auto
# Samples per encode() call. Lower it when VRAM is tight; raise it on CPU.
SENTENCE_TRANSFORMERS_BATCH_SIZE=32
# Normalized vectors make inner product == cosine, matching the vector store's metric.
SENTENCE_TRANSFORMERS_NORMALIZE=true
# false = only use the local HF cache (no implicit download at first use).
SENTENCE_TRANSFORMERS_ALLOW_DOWNLOAD=true

# Ollama (local service, no API key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:8b

# OpenRouter (cloud aggregator, OpenAI compatible) — optional cloud alternative.
# Kept for comparison runs; the free embedding route is rate-limited per DAY, so it cannot
# sustain repeated full-corpus rebuilds. Also: the free route may retain prompts for training.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v3.2
# 1024 dims but ONLY 512 tokens of context per input — pair it with EMBEDDING_MAX_INPUT_CHARS.
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# DeepSeek (chat only; no embedding endpoint)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Model names come from the official docs (https://api-docs.deepseek.com):
# `deepseek-flash` is the current default, `deepseek-v4-pro` is the stronger one.
# The legacy alias `deepseek-chat` still answers, but is no longer listed by
# /models — the health check warns about that instead of failing.
DEEPSEEK_CHAT_MODEL=deepseek-flash

# OpenAI (or any self-hosted OpenAI-compatible gateway — just change the base URL)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# ── 本地推理服务（vLLM / SGLang，OpenAI 兼容，无需 API Key） ──
# 把 LLM_PROVIDER 设为 vllm 即可切换到本地部署的模型；本地服务跑不起来时回退 deepseek。
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_CHAT_MODEL=/data/users/mapengcheng/rustproject/qwen25-32b-gptq

OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Mock provider: offline deterministic stand-ins
MOCK_CHAT_MODEL=mock-chat
MOCK_EMBEDDING_MODEL=mock-embedding
MOCK_EMBEDDING_DIM=256

# Cloud call parameters (temperature/max tokens are also applied to Ollama)
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# Reasoning effort (DeepSeek only): minimal | low | medium | high; empty = omit the field
LLM_REASONING_EFFORT=
# Per-input character cap before embedding (0 = no truncation). Chunks are cut by
# characters while models limit by tokens, so set this for small-context models:
#   liquid/lfm-2.5-embedding-350m:free (512 tokens) -> EMBEDDING_MAX_INPUT_CHARS=400
EMBEDDING_MAX_INPUT_CHARS=0
# Per-request timeout for embedding calls, in seconds. Set this explicitly: the OpenAI SDK
# defaults to 600s, so a single hung batch makes a bulk ingest look silently "stuck".
EMBEDDING_TIMEOUT=60.0
# Per-batch retry policy for embedding (exponential backoff = EMBED_RETRY_BACKOFF ** attempt).
# Batches are dispatched concurrently, so a hard failure cancels the sibling batches instead
# of letting them keep burning quota.
EMBED_MAX_ATTEMPTS=3
EMBED_RETRY_BACKOFF=2.0
# Log a progress line every N finished batches (0 = quiet). Bulk ingests are long enough
# that "no output at all" is indistinguishable from a hang.
EMBED_PROGRESS_EVERY=20

# ─────────────────────────── Vector Store ──────────────────────────
# Backend: zvec (default) | chroma | memory.
#   zvec   : embedded (Alibaba, HNSW + cosine, WAL). Zero extra services, but it takes an
#            exclusive write lock per collection directory — run a SINGLE process
#            (no `uvicorn --workers`, no multiple replicas sharing ./data).
#   chroma : kept only as a compatibility backend for pre-Phase-4 data.
#   memory : zero-dependency in-process store (Phase 7). Data lives in RAM only — it is
#            gone on restart and each instance keeps its own copy. Meant for tests, CI
#            and the "swap the backend without touching business code" drill.
# Switching backends (or changing chunking / embedding) does NOT convert data in place:
# rebuild with `uv run scripts/reindex_kb.py <kb_id>`.
# Unknown names fail fast and list the available backends (no silent fallback).
VECTOR_STORE=zvec
ZVEC_PATH=./data/zvec_db
# Only used when VECTOR_STORE=chroma. Collection names are always `kb_<id>` (one per
# knowledge base), so there is no global collection-name setting.
CHROMA_PERSIST_DIR=./data/chroma_db

# ─────────────────────────── Cache ─────────────────────────────────
# Backend for the query / embedding caches: memory (default).
#   memory : one bounded LRU per namespace; sizes and TTLs below.
# Swapping in Redis later means adding an implementation and registering it — no call
# site changes (see docs/architecture.md 3.4).
CACHE_BACKEND=memory
# Query cache: results of "kb_id + top_k + query" (invalidated per kb on ingest).
QUERY_CACHE_MAX_SIZE=500
# Seconds; 0 disables expiry. Ingestion already invalidates per kb, so this is a backstop.
QUERY_CACHE_TTL=300
# Embedding cache: keyed by vector-space identity, so it never leaks across models.
EMBEDDING_CACHE_MAX_SIZE=2000

# ─────────────────────────── Task Queue ────────────────────────────
# Backend for background work (document parsing → chunking → embedding):
#   inprocess : coroutine pool inside the API process (default).
#   inline    : runs the task synchronously inside submit(); failures propagate to the
#               caller. Used by tests and by scripts that must finish before returning.
TASK_QUEUE_BACKEND=inprocess
# Max concurrent jobs. Keep it small: the free embedding routes rate-limit aggressively.
TASK_QUEUE_CONCURRENCY=2
# Retries after the first failure, with backoff = TASK_QUEUE_RETRY_BACKOFF * attempt.
# Document processing is idempotent (chunk ids are deterministic), so one retry is safe.
TASK_QUEUE_MAX_RETRIES=1
TASK_QUEUE_RETRY_BACKOFF=5.0
# Bounded ring of recent task records exposed by GET /api/system/stats.
TASK_QUEUE_HISTORY=200

# ─────────────────────────── File Upload ───────────────────────────
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE=104857600
ALLOWED_EXTENSIONS=pdf,doc,docx,txt,md,csv,json,xml,html,htm,xls,xlsx,jpg,jpeg,png,gif,bmp,tiff,webp
# Server-side path import is disabled by default (it grants filesystem read access).
# Enable only if you need `POST /api/doc/import-path`, and set LOCAL_IMPORT_ROOT
# to the directory imports must stay inside.
ALLOW_LOCAL_IMPORT=false
LOCAL_IMPORT_ROOT=

# ─────────────────────────── OCR ───────────────────────────────────
# none | paddle  (paddle requires: uv sync --extra ocr-paddle)
OCR_BACKEND=none
OCR_LANG=ch
OCR_RENDER_DPI=200

# ─────────────────────────── RAG ───────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=8
RERANK_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.3
# hybrid 策略里词面检索（BM25）的权重：融合分 = max(向量相关度, 权重 × 归一化 BM25)。
# 0 = 退回纯向量 + MMR。定标依据见 docs/evaluation.md 4.5。
HYBRID_SPARSE_WEIGHT=0.6
# 词面这一路的启用门槛（原始 BM25）：稠密侧有过阈值候选，或词面最强匹配达到本值，才启用。
# 防止巧合的字面匹配（如香槟品牌「巴黎之花」）把「库里没有相关内容」翻案、破坏拒答。
# 该值是绝对量级、随语料规模变化，换语料要重标（见 docs/evaluation.md 4.5）。
HYBRID_MIN_SPARSE_SCORE=20.0
# Rerank: reorders the candidates that survived the threshold, right before context assembly.
#   none    : off (default). Reranking always changes the ordering, so it must earn its place
#             on the eval set before being turned on.
#   lexical : no model. Ranks by rarity-weighted coverage of the query terms *within this
#             candidate set* (terms every candidate has carry no information).
#   llm     : listwise — the model returns the preferred order of the top N candidates.
# Contract: only the order may change. Implementations must not add, drop or rescore items,
# and must fall back to the original order on any failure (see docs/architecture.md 3.9).
RERANK_BACKEND=none
# Only for RERANK_BACKEND=llm: how many candidates take part, and how many characters of
# each are sent (caps the prompt cost of a listwise call).
RERANK_LLM_TOP_N=12
RERANK_LLM_SNIPPET_CHARS=500
# Query rewrite: expands one question into several retrieval queries.
#   none     : off (default).
#   alias    : looks up QUERY_ALIASES ("alias=canonical"), case-insensitive for latin aliases.
#   keywords : strips Chinese question frames / function words, keeping real content words.
#   llm      : asks the model for paraphrases.
# Contract: the returned list is used as-is for recall and its FIRST item is always the
# original query, so a rewrite that helps nothing costs at most one extra recall pass.
QUERY_REWRITE_BACKEND=none
# Cap on variants per question, original query included. Each variant is one more recall pass,
# so this also caps the cost multiplier.
QUERY_REWRITE_MAX_QUERIES=3
# Alias table for QUERY_REWRITE_BACKEND=alias: comma-separated "alias=canonical" pairs.
# Malformed lines are reported as warnings and skipped, never silently ignored.
QUERY_ALIASES=
MAX_CONTEXT_LENGTH=6000
# How many recent messages are sent to the model as conversation history.
HISTORY_MAX_MESSAGES=20

# ─────────────────────────── Async worker ──────────────────────────
EMBEDDING_CONCURRENCY=3
EMBED_BATCH_SIZE=20

# ─────────────────────────── CORS ──────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────── Logging ───────────────────────────────
LOG_DIR=./logs
LOG_RETRIEVAL=true
LOG_PROMPT=true
LOG_LEVEL=INFO
# text (human readable) | json (one JSON object per line, for log collectors)
LOG_FORMAT=text
# Trace sampling rate for successful requests; failed requests are always recorded.
LOG_SAMPLE_RATE=1.0

# ─────────────────────────── Observability ──────────────────────────
# LangSmith tracing: OFF by default so tests and CI stay offline and free.
# When it is off, spans are still timed and written to the local log, so you do not
# lose timing attribution — only the remote trace view.
# Missing key, init failure or upload failure all degrade to local logging and are
# counted in `tracing_errors_total`; they never fail a request.
LANGSMITH_TRACING=false
# Do NOT put a real key here. Export it in your shell / ~/.zshrc instead:
#   export LANGSMITH_API_KEY=...
# env vars take precedence over this file, so exporting is enough and the secret
# never lands in a file that gets copied around.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=inner-rag
# Leave empty for the official SaaS; set the full URL for self-hosted / proxy.
LANGSMITH_ENDPOINT=
LANGSMITH_WORKSPACE_ID=
# GET /api/system/metrics output: none (JSON) | prometheus (text exposition)
METRICS_BACKEND=none
# When non-empty, GET /api/system/metrics requires the X-Metrics-Token header
# (the endpoint is not behind login, so scrapers can poll it directly).
METRICS_TOKEN=
